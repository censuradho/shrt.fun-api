// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "generated"
}

datasource db {
  provider = "postgresql"
}


model Hit {
  id String @id

  urlId String
  url Url @relation(fields: [urlId], references: [id])

  ipAddress String
  userAgent String

  createdAt DateTime @default(now())

  @@map("hits")
}

model Url {
  id String @id

  originalUrl String
  shortUrl String @unique

  hits Hit[]
  hitsCount Int @default(0)

  isActive Boolean @default(true)
  description String?
  tags String[]

  supabaseId String?
  user User? @relation(fields: [supabaseId], references: [supabaseId])

  expireAt DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("urls")
}

model User {
  id String @id

  email String @unique
  username String
  firstName String
  lastName String
  supabaseId String @unique
  
  isActive Boolean @default(true)

  urls Url[]

  planId String
  plan Plan @relation(fields: [planId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("users")
}

model Plan {
  id String @id

  name String
  monthlyLinkLimit Int 

  users User[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("plans")
}